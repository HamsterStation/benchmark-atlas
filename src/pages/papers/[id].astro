---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import { loadCatalog, taxonomy, root } from '../../lib/catalog.mjs';
import { withBase } from '../../lib/paths';
import { renderNote } from '../../lib/notes.mjs';
export function getStaticPaths() { return loadCatalog().map(p => ({ params: { id: p.id }, props: { paper: p } })); }
const { paper: p } = Astro.props;
const notePath = path.join(root, 'notes', `${p.id}.md`);
const note = fs.existsSync(notePath) ? renderNote(fs.readFileSync(notePath, 'utf8')) : null;
const scopeLabels = { abstract: '仅摘要级整理，未阅读全文', abstract_and_official_docs: '摘要与官方文档整理，未阅读全文', fulltext: '基于全文材料整理', manual: '人工材料整理' };
const methodSources = p.sources.filter((s: { kind: string }) => ['official_repository', 'official_documentation'].includes(s.kind));
const methodLabels = { model: '自动整理', manual: '人工整理', source_check: '来源材料整理', metadata_only: '来源信息整理' };
---
<Layout title={p.acronym || p.title}>
  <a class="back-link" href={withBase('#catalog')}>← 返回论文索引</a>
  <header class="paper-hero">
    <p class="eyebrow">RESEARCH RECORD / {p.arxivId}</p>
    <div class="tags"><span class="role">{taxonomy.roles[p.role].label}</span></div>
    {p.acronym && <p class="detail-acronym">{p.acronym}</p>}
    <h1>{p.title}</h1>
    <p class="authors">{p.authors.length ? p.authors.join(', ') : '作者信息未提供'}</p>
    <a class="primary-link" href={p.paperUrl} rel="noopener noreferrer">原论文 · {p.version ? `v${p.version}` : '版本未注明'} ↗</a>
  </header>
  <div class="date-grid">
    <div><span>论文首发日期（arXiv）</span><strong>{p.publishedAt || '未提供'}</strong></div>
    <div><span>论文版本更新时间</span><strong>{p.versionUpdatedAt || '未提供'}</strong></div>
    <div><span>本站首次收录</span><strong>{p.addedAt}</strong></div>
    <div><span>本站资料更新时间</span><strong>{p.updatedAt}</strong></div>
  </div>
  <div class="detail-columns">
    <div class="detail-main">
      <section>
        <p class="eyebrow">01 / OVERVIEW</p><h2>中文简介</h2>
        <p class="lead-summary">{p.summaryZh || '中文简介尚未整理。'}</p>
        <p class="scope-note">{scopeLabels[p.provenance.materialScope as keyof typeof scopeLabels]}。</p>
        <h3>任务形式</h3><p>{p.taskFormat || '来源材料中尚未整理出任务说明。'}</p>
        <h3>主要指标</h3>
        {p.metrics.length ? <dl class="metrics">{p.metrics.map((m: { name: string; description: string; sourceUrl: string }) => <div><dt>{m.name}</dt><dd>{m.description} <a href={m.sourceUrl} rel="noopener noreferrer">来源 ↗</a></dd></div>)}</dl> : <p>指标细节请参阅原论文。</p>}
      </section>
      <section id="reproduction">
        <p class="eyebrow">02 / HOW TO RUN</p><h2>复现方法</h2>
        {methodSources.length > 0 && <>
          <p class="scope-note">从官方文档中的环境准备、数据配置和评测步骤开始，适用环境以对应版本为准。</p>
          <ul class="method-links">{methodSources.map((s: { url: string; version: string | null }) => <li><a href={s.url} rel="noopener noreferrer">官方运行文档 ↗</a>{s.version && <span> · {s.version.slice(0, 12)}</span>}</li>)}</ul>
        </>}
        {p.reproduction.notes && <p>{p.reproduction.notes}</p>}
        {p.reproduction.commands.length > 0 && <>
          <h3>官方命令摘录</h3>
          {p.reproduction.commands.map((c: { text: string; context: string; sourceUrl: string; sourceVersion: string }) => <div class="command"><pre><code>{c.text}</code></pre>{c.context !== p.reproduction.notes && <p>{c.context}</p>}<a href={c.sourceUrl} rel="noopener noreferrer">官方来源 · {c.sourceVersion.slice(0, 12)} ↗</a></div>)}
        </>}
        {!methodSources.length && !p.reproduction.commands.length && <p>暂未整理可引用的官方运行步骤。可先查看<a href={p.paperUrl} rel="noopener noreferrer">原论文的实验设置与资源链接 ↗</a>。</p>}
        {(note || p.reproduction.runs.length > 0) && <details>
          <summary>补充运行记录与笔记</summary>
          {p.reproduction.runs.map((r: { date: string; operator: string; commit: string; environment: string; scope: string; result: string; experiment: string | null }) => <dl class="run-record"><dt>日期 / 操作者</dt><dd>{r.date} / {r.operator}</dd><dt>Commit</dt><dd><code>{r.commit}</code></dd><dt>环境</dt><dd>{r.environment}</dd><dt>验证范围</dt><dd>{r.scope}</dd><dt>结果</dt><dd>{r.result}</dd>{r.experiment && <><dt>指定实验</dt><dd>{r.experiment}</dd></>}</dl>)}
          {note && <div class="prose" set:html={note} />}
        </details>}
      </section>
      <section>
        <p class="eyebrow">03 / SOURCES</p><h2>来源与材料范围</h2>
        <ol class="source-list">{p.sources.map((s: { url: string; kind: string; scope: string; version: string | null }) => <li><a href={s.url} rel="noopener noreferrer">{s.kind === 'arxiv_abstract' ? 'arXiv 原论文摘要' : '官方材料'} ↗</a><p>{s.scope}</p>{s.version && <small>来源版本：{s.version}</small>}</li>)}</ol>
        <dl class="metadata">
          <dt>整理方式</dt><dd>{methodLabels[p.provenance.method as keyof typeof methodLabels]}</dd>
          <dt>材料版本</dt><dd>{p.provenance.materialVersion || '来源未注明'}</dd>
          {p.provenance.generatedAt && <><dt>整理时间</dt><dd>{p.provenance.generatedAt}</dd></>}
          {p.provenance.materialTruncated && <><dt>材料范围补充</dt><dd>仅使用所取得材料的部分内容。</dd></>}
        </dl>
      </section>
    </div>
    <aside class="detail-aside">
      <section><h2>研究坐标</h2>{[['targets', '评测对象'], ['scenarios', '任务场景'], ['capabilities', '能力标签']].map(([key, label]) => <div><h3>{label}</h3><div class="tags">{p[key].length ? p[key].map((t: string) => <span>{taxonomy[key][t].label}</span>) : '尚未分类'}</div></div>)}</section>
      <section><h2>官方资源</h2><p>{p.officialCode ? <a href={p.officialCode} rel="noopener noreferrer">代码与项目 ↗</a> : '暂未提供独立代码入口'}</p><p>{p.officialData ? <a href={p.officialData} rel="noopener noreferrer">数据入口 / 官方下载说明 ↗</a> : '暂未提供独立数据入口'}</p><p class="scope-note">资源链接与方法说明来自列出的材料，使用条件以官方文档为准。</p></section>
      <p class="record-id">稳定 ID<br /><code>{p.id}</code></p>
    </aside>
  </div>
</Layout>
