---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import { loadCatalog, taxonomy, root } from '../../lib/catalog.mjs';
import { withBase } from '../../lib/paths';
import { renderNote } from '../../lib/notes.mjs';
export function getStaticPaths() { return loadCatalog().map(p => ({ params: { id: p.id }, props: { paper: p } })); }
const { paper: p } = Astro.props;
const notePath = path.join(root, 'notes', `${p.id}.md`);
const note = fs.existsSync(notePath) ? renderNote(fs.readFileSync(notePath, 'utf8')) : null;
const scopeLabels = { abstract: '仅摘要级整理，未阅读全文', abstract_and_official_docs: '摘要与官方文档整理，未阅读全文', fulltext: '基于全文材料整理', manual: '人工材料整理' };
---
<Layout title={p.acronym || p.title}>
  <a class="back-link" href={withBase('#catalog')}>← 返回论文索引</a>
  <header class="paper-hero"><p class="eyebrow">RESEARCH RECORD / {p.arxivId}</p><div class="tags"><span class="role">{taxonomy.roles[p.role].label}</span><span class="status">{taxonomy.reviewStatuses[p.review.status].label}</span></div><p class="detail-acronym">{p.acronym || '简称待核查'}</p><h1>{p.title}</h1><p class="authors">{p.authors.length ? p.authors.join(', ') : '作者待核查'}</p><a class="primary-link" href={p.paperUrl} rel="noopener noreferrer">原论文 · {p.version ? `v${p.version}` : '版本待核查'} ↗</a></header>
  <div class="date-grid"><div><span>论文首发日期（arXiv）</span><strong>{p.publishedAt || '待核查'}</strong></div><div><span>论文版本更新时间</span><strong>{p.versionUpdatedAt || '待核查'}</strong></div><div><span>本站核查日期</span><strong>{p.checkedAt || '待核查'}</strong></div><div><span>本站资料更新时间</span><strong>{p.updatedAt}</strong></div></div>
  {p.review.status === 'auto_unreviewed' && <p class="notice">自动收录、未审核：以下分类和简介是机器草稿，请结合原文自行核对。</p>}
  <div class="detail-columns"><div class="detail-main">
    <section><p class="eyebrow">01 / OVERVIEW</p><h2>它评测什么？</h2><p class="scope-note">{scopeLabels[p.provenance.materialScope as keyof typeof scopeLabels]}。中文介绍未经过论文作者确认。</p><p class="lead-summary">{p.summaryZh || '中文简介待核查'}</p><h3>任务形式</h3><p>{p.taskFormat || '待核查'}</p><h3>主要指标</h3>{p.metrics.length ? <dl class="metrics">{p.metrics.map((m: { name: string; description: string; sourceUrl: string }) => <div><dt>{m.name}</dt><dd>{m.description} <a href={m.sourceUrl} rel="noopener noreferrer">来源 ↗</a></dd></div>)}</dl> : <p>待核查</p>}</section>
    <section id="reproduction"><p class="eyebrow">02 / REPRODUCIBILITY</p><h2>复现信息</h2><p class="repro-status">{taxonomy.reproductionStatuses[p.reproduction.status].label}</p><p>{p.reproduction.notes || '待核查'}</p><h3>官方命令摘录</h3><p class="scope-note">只供阅读的文档摘录。本站没有自动执行论文仓库代码；命令的依赖、权限和适用版本需按来源文档确认。</p>{p.reproduction.commands.length ? p.reproduction.commands.map((c: { text: string; context: string; sourceUrl: string; sourceVersion: string }) => <div class="command"><pre><code>{c.text}</code></pre><p>{c.context}</p><a href={c.sourceUrl} rel="noopener noreferrer">官方来源 · {c.sourceVersion.slice(0, 12)} ↗</a></div>) : <p>待核查：尚无可展示的官方命令。</p>}<h3>人工运行记录</h3>{p.reproduction.runs.length ? p.reproduction.runs.map((r: { date: string; operator: string; commit: string; environment: string; scope: string; result: string; experiment: string | null }) => <dl class="run-record"><dt>日期 / 操作者</dt><dd>{r.date} / {r.operator}</dd><dt>Commit</dt><dd><code>{r.commit}</code></dd><dt>环境</dt><dd>{r.environment}</dd><dt>验证范围</dt><dd>{r.scope}</dd><dt>结果</dt><dd>{r.result}</dd><dt>指定实验</dt><dd>{r.experiment || '待核查'}</dd></dl>) : <p>暂无实测记录。未经运行，不标记“最小示例跑通”或“指定实验结果复现”。</p>}</section>
    <section><p class="eyebrow">03 / HUMAN NOTES</p><h2>人工复现笔记</h2>{note ? <div class="prose" set:html={note} /> : <p>暂无人工笔记。人工 Markdown 与机器草稿分别保存。</p>}</section>
    <section><p class="eyebrow">04 / SOURCES</p><h2>来源与核查范围</h2><ol class="source-list">{p.sources.map((s: { url: string; kind: string; scope: string; version: string | null; checkedAt: string | null }) => <li><a href={s.url} rel="noopener noreferrer">{s.kind === 'arxiv_abstract' ? 'arXiv 原论文摘要' : '官方材料'} ↗</a><p>{s.scope}</p><small>来源版本：{s.version || '待核查'}<br />核查日期：{s.checkedAt || '待核查'}</small></li>)}</ol><dl class="metadata"><dt>整理方式</dt><dd>{p.provenance.method}</dd><dt>材料版本</dt><dd>{p.provenance.materialVersion || '待核查'}</dd><dt>生成时间</dt><dd>{p.provenance.generatedAt || '无自动生成时间记录'}</dd><dt>输入截断</dt><dd>{p.provenance.materialTruncated ? '是，仅使用限制内的材料' : '否'}</dd><dt>人工审核人 / 日期</dt><dd>{p.review.reviewer || '待核查'} / {p.review.reviewedAt || '待核查'}</dd><dt>本站首次收录</dt><dd>{p.addedAt}</dd></dl></section>
  </div><aside class="detail-aside"><section><h2>研究坐标</h2>{[['targets', '评测对象'], ['scenarios', '任务场景'], ['capabilities', '能力标签']].map(([key, label]) => <div><h3>{label}</h3><div class="tags">{p[key].length ? p[key].map((t: string) => <span>{taxonomy[key][t].label}</span>) : '待核查'}</div></div>)}</section><section><h2>官方资源</h2><p>{p.officialCode ? <a href={p.officialCode} rel="noopener noreferrer">代码与项目 ↗</a> : '官方代码：待核查'}</p><p>{p.officialData ? <a href={p.officialData} rel="noopener noreferrer">数据入口 / 官方下载说明 ↗</a> : '官方数据：待核查'}</p><p class="scope-note">资源入口来自列出的官方材料。可访问性、许可与下载权限可能变化，本站不托管数据或权重。</p></section><p class="record-id">稳定 ID<br /><code>{p.id}</code></p></aside></div>
</Layout>
